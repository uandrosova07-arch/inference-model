+            query_components: &Bound<'py, PyAny>,
+            query_values: PyReadonlyArrayDyn<'py, f32>,
+            k: usize,
+            query_cut: usize,
+            heap_factor: f32,
+            stop_eps: f32,
+            min_terms: usize,
+            n_knn: usize,
+            sorted: bool,
